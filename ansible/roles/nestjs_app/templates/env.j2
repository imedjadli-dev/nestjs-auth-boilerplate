
# Application
NODE_ENV=production
PORT={{ app_port }}
APP_ENV_FILE={{ app_dir }}/.env

# Database and Redis (docker-compose overrides these with container hostnames)
DATABASE_URL=postgresql://{{ postgres_user }}:{{ postgres_password | urlencode }}@postgres:5432/{{ postgres_db }}
REDIS_URL=redis://default:{{ redis_password | urlencode }}@redis:6379

# JWT
JWT_SECRET={{ jwt_secret }}
JWT_EXPIRES_IN={{ jwt_expires_in }}
JWT_REFRESH_SECRET={{ jwt_refresh_secret }}
JWT_REFRESH_EXPIRES_IN={{ jwt_refresh_expires_in }}

# Mail
MAIL_HOST={{ mail_host }}
MAIL_PORT={{ mail_port }}
MAIL_SECURE={{ mail_secure }}
MAIL_USER={{ mail_user }}
MAIL_PASS={{ mail_pass }}
MAIL_FROM={{ mail_from }}

# Docker Compose
POSTGRES_USER={{ postgres_user }}
POSTGRES_PASSWORD={{ postgres_password }}
POSTGRES_DB={{ postgres_db }}
REDIS_PASSWORD={{ redis_password }}
GRAFANA_ADMIN_USER={{ grafana_admin_user }}
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password }}

# Image (used by docker-compose.yml)
IMAGE_NAME={{ image_name }}
IMAGE_TAG={{ image_tag }}